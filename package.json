{
  "name": "relay-playground",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --kill-signal SIGTERM -n server,client -c blue,green \"yarn workspace server dev\" \"yarn workspace client dev\"",
    "relay": "yarn workspace client relay",
    "relay:watch": "yarn workspace client relay --watch",
    "build": "yarn workspaces foreach -A run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0"
  },
  "engines": {
    "node": ">=24.11 <25"
  },
  "packageManager": "yarn@4.14.1"
}
