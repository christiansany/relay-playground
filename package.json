{
  "name": "relay-playground",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=24.11 <25"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"yarn workspace server dev\" \"yarn workspace client dev\"",
    "relay": "yarn workspace client relay",
    "relay:watch": "yarn workspace client relay --watch",
    "build": "yarn workspaces foreach -A run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
